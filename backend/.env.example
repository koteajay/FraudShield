APP_NAME=FraudShield
APP_ENV=development
DATABASE_URL=sqlite:///./fraudshield.db
API_PREFIX=/api
LOG_LEVEL=INFO
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Phase 3: Fraud Rule Engine Configuration
VELOCITY_THRESHOLD_COUNT=5
VELOCITY_WINDOW_MINUTES=5
UNUSUAL_AMOUNT_MULTIPLIER=3.0
UNUSUAL_AMOUNT_MIN_HISTORY=3
UNUSUAL_AMOUNT_MIN_THRESHOLD=100.0
IMPOSSIBLE_TRAVEL_MAX_SPEED_KMH=900.0
UNUSUAL_TIME_MIN_HISTORY=5
UNUSUAL_TIME_BUFFER_HOURS=1
FAILED_LOGIN_THRESHOLD=3
FAILED_LOGIN_WINDOW_MINUTES=10
UNUSUAL_MERCHANT_MIN_HISTORY=3
BLACKLISTED_COUNTRIES=["PRK","IRN","SYR","CUB","RUS"]

# Phase 4: Risk Scoring & Threshold Configuration
RISK_LOW_MAX=29
RISK_MEDIUM_MAX=59
RISK_HIGH_MAX=79
SCORE_TRANSACTION_VELOCITY=25
SCORE_UNUSUAL_TRANSACTION_AMOUNT=30
SCORE_IMPOSSIBLE_GEOGRAPHICAL_LOCATION=35
SCORE_DEVICE_CHANGE=15
SCORE_UNUSUAL_TIME=10
SCORE_MULTIPLE_FAILED_LOGIN=20
SCORE_UNUSUAL_MERCHANT=15
SCORE_BLACKLISTED_COUNTRY=30

# Phase 5: User Behaviour Profile Configuration
BEHAVIOUR_PROFILE_DAYS=30
PROFILE_INSUFFICIENT_THRESHOLD=5
PROFILE_DEVELOPING_THRESHOLD=20
PROFILE_AMOUNT_RANGE_MULTIPLIER=1.5
PROFILE_LOCATION_MIN_COUNT=1

# Phase 7: Account Takeover Detection Configuration
ATO_MEDIUM_SIGNAL_COUNT=2
ATO_HIGH_SIGNAL_COUNT=3
ATO_CRITICAL_SIGNAL_COUNT=4
ATO_FAILED_LOGIN_WINDOW_MINUTES=30
ATO_FAILED_LOGIN_THRESHOLD=3

# Phase 8: Transaction Journey Configuration
JOURNEY_BEFORE_MINUTES=30
JOURNEY_AFTER_MINUTES=30


